    # Task 111: Jul 23 2024 — summer low wind, 59 GW, thermal-dominated
  111) TAG="final-jul23"; BASE="sced_inputs_v3"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-07-23"; HL="$SCRATCH/hourly_load_20240723.csv"; HC="$SCRATCH/hourly_cf_20240723.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T175"; RFACT="0.15"; LRELIEF="$SCRATCH/sced_inputs_upgr-aug20-t175/results_upgr-aug20-t175/bus_detail.csv"; LRELIEF_THRESH="2000"; LRELIEF_PCT="0.05"; LRELIEF_K="5"; LRELIEF_ZERO="OSM_3112"; LRELIEF_TAP="0" ;;
    # --- 5 edge cases (scaled load profiles) ---
    # Task 112: 80 GW stress — Aug 20 profile × 1.04 (~82 GW peak)
  112) TAG="stress-80gw"; BASE="sced_inputs_v3"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-08-20"; HL="$SCRATCH/hourly_load_20240820.csv"; HC="$SCRATCH/hourly_cf_20240820.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T175"; RFACT="0.15"; LRELIEF="$SCRATCH/sced_inputs_upgr-aug20-t175/results_upgr-aug20-t175/bus_detail.csv"; LRELIEF_THRESH="2000"; LRELIEF_PCT="0.05"; LRELIEF_K="5"; LRELIEF_ZERO="OSM_3112"; LRELIEF_TAP="0"; LSCALE="1.04" ;;
    # Task 113: 85 GW stress — Aug 20 profile × 1.10 (~87 GW peak)
  113) TAG="stress-85gw"; BASE="sced_inputs_v3"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-08-20"; HL="$SCRATCH/hourly_load_20240820.csv"; HC="$SCRATCH/hourly_cf_20240820.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T175"; RFACT="0.15"; LRELIEF="$SCRATCH/sced_inputs_upgr-aug20-t175/results_upgr-aug20-t175/bus_detail.csv"; LRELIEF_THRESH="2000"; LRELIEF_PCT="0.05"; LRELIEF_K="5"; LRELIEF_ZERO="OSM_3112"; LRELIEF_TAP="0"; LSCALE="1.10" ;;
    # Task 114: 20 GW floor — Mar 29 profile × 0.47 (~20 GW peak)
  114) TAG="floor-20gw"; BASE="sced_inputs_v3"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-03-29"; HL="$SCRATCH/hourly_load_20240329.csv"; HC="$SCRATCH/hourly_cf_20240329.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T175"; RFACT="0.15"; LRELIEF="$SCRATCH/sced_inputs_upgr-aug20-t175/results_upgr-aug20-t175/bus_detail.csv"; LRELIEF_THRESH="2000"; LRELIEF_PCT="0.05"; LRELIEF_K="5"; LRELIEF_ZERO="OSM_3112"; LRELIEF_TAP="0"; LSCALE="0.47" ;;
    # Task 115: 90 GW extreme — Aug 20 profile × 1.17 (~92 GW peak)
  115) TAG="stress-90gw"; BASE="sced_inputs_v3"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-08-20"; HL="$SCRATCH/hourly_load_20240820.csv"; HC="$SCRATCH/hourly_cf_20240820.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T175"; RFACT="0.15"; LRELIEF="$SCRATCH/sced_inputs_upgr-aug20-t175/results_upgr-aug20-t175/bus_detail.csv"; LRELIEF_THRESH="2000"; LRELIEF_PCT="0.05"; LRELIEF_K="5"; LRELIEF_ZERO="OSM_3112"; LRELIEF_TAP="0"; LSCALE="1.17" ;;
    # Task 116: 40 GW moderate — Jan 8 profile × 0.85 (~40 GW peak)
  116) TAG="moderate-40gw"; BASE="sced_inputs_v3"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T175"; RFACT="0.15"; LRELIEF="$SCRATCH/sced_inputs_upgr-aug20-t175/results_upgr-aug20-t175/bus_detail.csv"; LRELIEF_THRESH="2000"; LRELIEF_PCT="0.05"; LRELIEF_K="5"; LRELIEF_ZERO="OSM_3112"; LRELIEF_TAP="0"; LSCALE="0.85" ;;
     # Task 117: No nuclear — Jan 8 with CPSES + STP decommissioned (4 units, ~4,740 MW removed)
   117) TAG="no-nuke-jan08"; BASE="sced_inputs_v3_no_nuke"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv"; FCSV="$SCRATCH/jun17_floor_cap1200.csv"; UPGR="$T135"; RFACT="0.15" ;;
esac

echo "============================================"
echo "Task:        $SLURM_ARRAY_TASK_ID"
echo "Experiment:  $TAG"
echo "BRANCH_SCALE=$SCALE  NO_SPL_CAP=$NO_SPL  LOAD_NAMED_ONLY=$LOAD_NAMED  SCALE_345KV=$SCALE_HV  SCALE_138KV=$SCALE_LV"
echo "SCED_DATE=$SCED_DT  HOURLY_LOAD_CSV=$HL  HOURLY_CF_CSV=$HC"
echo "LOAD_ALLOC=${LALLOC:-pop}  DEGREE_ALPHA=${DALPHA:-1.0}"
echo "STORAGE_AGGREGATE=${STOR_AGG:-zone}"
echo "RESERVE_FACTOR=${RFACT:-0.05}"
echo "LOAD_SCALE=${LSCALE:-1.0}"
echo "LOAD_RELIEF_CSV=${LRELIEF:-}"
echo "RELIEF_LMP_THRESH=${LRELIEF_THRESH:-2000}  RELIEF_PCT=${LRELIEF_PCT:-0.05}  K=${LRELIEF_K:-5}"
echo "Node:        $(hostname)"
echo "CPUs:        $SLURM_CPUS_PER_TASK"
echo "Started:     $(date)"
echo "============================================"

# Each task gets its own copy of sced_inputs so branch.csv edits don't collide
INSTANCE_DIR=$SCRATCH/sced_inputs_${TAG}
BASE_DIR=${BASE:-sced_inputs}
if [ ! -d "$INSTANCE_DIR" ]; then
    echo "Copying ${BASE_DIR} → sced_inputs_${TAG}..."
    cp -r $SCRATCH/${BASE_DIR} $INSTANCE_DIR
fi

export DARTBOARD_SCRATCH=$SCRATCH
export SCED_INSTANCE=$TAG
export EXPERIMENT_TAG=$TAG
export BRANCH_SCALE=$SCALE
export NO_SPL_CAP=$NO_SPL
export LOAD_NAMED_ONLY=$LOAD_NAMED
export SCALE_345KV=$SCALE_HV
export SCALE_138KV=$SCALE_LV
export NO_PLANT_CAP=$NO_PLANT
export SCED_DATE=$SCED_DT
export HOURLY_LOAD_CSV=$HL
export HOURLY_CF_CSV=$HC
export LOAD_ALLOC=${LALLOC:-pop}
export UPGRADE_LINES=${UPGR:-}
export FLOOR_RATINGS_CSV=${FCSV:-}
export STORAGE_AGGREGATE=${STOR_AGG:-zone}
export RESERVE_FACTOR=${RFACT:-0.05}
export DEGREE_ALPHA=${DALPHA:-1.0}
export MUST_RUN_MIN_MW=${MRMW:-100}
export FEEDBACK_COMMIT=${FBCOMMIT:-0}
export FEEDBACK_MAX_HOPS=${FBHOPS:-3}
export LOAD_RELIEF_CSV=${LRELIEF:-}
export RELIEF_LMP_THRESH=${LRELIEF_THRESH:-2000}
export RELIEF_PCT=${LRELIEF_PCT:-0.05}
export RELIEF_K_NEAREST=${LRELIEF_K:-5}
export RELIEF_ZERO_BUSES=${LRELIEF_ZERO:-}
export RELIEF_TAP_MW=${LRELIEF_TAP:-10}
export LOAD_SCALE=${LSCALE:-1.0}

cd /tmp && $ENV/bin/python $SCRATCH/run_sced.py

echo "Finished: $(date)"
