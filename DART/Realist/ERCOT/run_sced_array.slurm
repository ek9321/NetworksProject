T144="L1750_2840,L2004_2056,L2613_4090,L2268_2269,L1922_2269,L2094_2165,L2165_2767,L1474_1647,L1733_2338,L3112_4471,L4281_4283,L4394_4395,L2135_2484,L219_1922,L1494_4277,L4021_4063,L4021_4572,L3977_3989,L3136_4277,L1413_1415,L749_2342,L760_761,L4259_4260,L2779_3893,L2755_2776,L760_2286,L3123_4395,L2625_2626,L3136_3987,L1854_1855,L3123_3124,L240_241,L1846_4493,L3125_3781,L3124_3125,L2750_2760,L2738_3231,L2212_3975,L2021_2626,L3144_3997,L1807_3117,L2064_3404,L4595_4596,L22_4412,L1857_4397,L2144_2657,L2601_2715,L2025_2833,L80_4431,L1825_4056,L2655_3146,L2225_2767,L33_1950,L2782_4443,L239_240,L680_2697,L680_4848,L862_3403,L3210_4001,L22_3817,L2199_2630,L4320_4322,L3249_4322,L1559_3016,L204_888,L5_3629,L2608_5020,L2239_3612,L187_2728,L187_191,L2064_2239,L3249_3626,L3265_4141,L4147_4148,L3410_4147,L550_551,L1559_1767,L409_2048,L1039_1051,L3572_4283,L1846_4409,L673_3178,L1614_1797,L1796_1799,L2739_3438,L4432_4603,L3600_3604,L745_746,L1829_3063,L3063_3572,L753_2253,L970_2840,L3112_3113,L2225_2755,L2753_4334,L4430_4431,L1819_2672,L1792_1793,L3112_4242,L1544_1549,L1544_3557,L2314_2628,L3287_3495,L747_748,L748_750,L2741_2744,L2031_2710,L74_2625,L1945_1946,L655_1921,L655_2031,L4110_4373,L1722_4200,L2334_3472,L2656_3436,L2333_2334,L2208_4471,L4317_4320,L1801_1859,L2227_3878,L2684_2685,L2199_2723,L3640_4072,L3430_4478,L3430_3644,L3266_4141,L2215_2625,L1714_1734,L1714_2338,L2735_2736,L450_2039,L2076_2117,L3143_3144,L4077_4525,L3190_3991,L2445_2446,L245_246,L2325_2326,L2816_2817,L2477_2478,L2172_2446"
T135="L1750_2840,L2004_2056,L2613_4090,L2268_2269,L1922_2269,L2094_2165,L2165_2767,L1474_1647,L1733_2338,L3112_4471,L4281_4283,L4394_4395,L2135_2484,L219_1922,L1494_4277,L4021_4063,L4021_4572,L3977_3989,L3136_4277,L1413_1415,L749_2342,L760_761,L4259_4260,L2779_3893,L2755_2776,L760_2286,L3123_4395,L2625_2626,L3136_3987,L1854_1855,L3123_3124,L240_241,L1846_4493,L3125_3781,L3124_3125,L2750_2760,L2738_3231,L2212_3975,L2021_2626,L3144_3997,L1807_3117,L2064_3404,L4595_4596,L22_4412,L1857_4397,L2144_2657,L2601_2715,L2025_2833,L80_4431,L1825_4056,L2655_3146,L2225_2767,L33_1950,L2782_4443,L239_240,L680_2697,L680_4848,L862_3403,L3210_4001,L22_3817,L2199_2630,L4320_4322,L3249_4322,L1559_3016,L204_888,L5_3629,L2608_5020,L2239_3612,L187_2728,L187_191,L2064_2239,L3249_3626,L3265_4141,L4147_4148,L3410_4147,L550_551,L1559_1767,L409_2048,L1039_1051,L3572_4283,L1846_4409,L673_3178,L1614_1797,L1796_1799,L2739_3438,L4432_4603,L3600_3604,L745_746,L1829_3063,L3063_3572,L753_2253,L970_2840,L3112_3113,L2225_2755,L2753_4334,L4430_4431,L1819_2672,L1792_1793,L3112_4242,L1544_1549,L1544_3557,L2314_2628,L3287_3495,L747_748,L748_750,L2741_2744,L2031_2710,L74_2625,L1945_1946,L655_1921,L655_2031,L4110_4373,L1722_4200,L2334_3472,L2656_3436,L2333_2334,L2208_4471,L4317_4320,L1801_1859,L2227_3878,L2684_2685,L2199_2723,L3640_4072,L3430_4478,L3430_3644,L3266_4141,L2215_2625,L1714_1734,L1714_2338,L2735_2736,L450_2039,L2076_2117,L3143_3144,L4077_4525,L3190_3991"

mkdir -p $SCRATCH/logs

module purge
module load anaconda3/2024.10 gurobi/11.0.3

export GRB_LICENSE_FILE=/usr/licensed/gurobi/license/gurobi.lic

# Map array task ID → experiment parameters
# Columns: TAG, BRANCH_SCALE, NO_SPL_CAP, LOAD_NAMED_ONLY, SCALE_345KV, SCALE_138KV, NO_PLANT_CAP,
#          SCED_DATE, HOURLY_LOAD_CSV, HOURLY_CF_CSV
case $SLURM_ARRAY_TASK_ID in
    0) TAG="floor";            SCALE="0";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    1) TAG="2x";               SCALE="2.0"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    2) TAG="no-spl-cap";       SCALE="1";   NO_SPL="1"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    3) TAG="no-spl+load-fix";  SCALE="1";   NO_SPL="1"; LOAD_NAMED="1"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    4) TAG="no-spl+hv2x";      SCALE="1";   NO_SPL="1"; LOAD_NAMED="0"; SCALE_HV="2"; SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    5) TAG="no-spl+138kv2x";   SCALE="1";   NO_SPL="1"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="2"; NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    6) TAG="best-so-far";       SCALE="1";   NO_SPL="1"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="2"; NO_PLANT="1"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 7: rebuilt branch.csv (600 MVA 138kV, SPL+plant baked in).
    #   Requires running build_osm_branch_table.py on adroit first (see session_2026-03-20.md).
    #   Use the new sced_inputs_clean-build dir built from the updated scripts.
    7) TAG="clean-build";       SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 8: June 17 2024 calibration day — hourly load + hourly wind/solar CFs.
    #   Requires hourly_load_20240617.csv and hourly_cf_20240617.csv in $SCRATCH.
    8) TAG="jun17-hourly";      SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 9: clean-build + 345 kV 2× — raises ERCOT backbone 345 kV to double-circuit (2400 MVA).
    #   Tests whether the 5 residual binding 345 kV backbone lines clear.
    9) TAG="hv2400";             SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="2"; SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 10: rebuilt branch.csv with 345 kV default=2 circuits (only Hicks→WC upgraded from default).
    #   Tests incremental effect of the 345 kV default change.
   10) TAG="hv-default2";        SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 11: jun17-hourly with hv2400 — June 17 2024 with all 345 kV at double-circuit.
    # NOTE: SCALE_345KV=2 also doubles Morgan Creek→Tonkawa (the WESTEX line) from 1200→2400 MVA.
    # If WESTEX binding disappears, we lose the WEST-NORTH spread. This is a diagnostic test.
   11) TAG="jun17-hv2400";       SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="2"; SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 12: targeted-hv — rebuilt branch.csv with targeted 345 kV overrides
    #   (Meadow→Oasis + Wharton→Addicks at 2400 MVA; Morgan Creek→Tonkawa stays 1200).
    #   Also has corrected gen.csv with full MORA renewable fleet (~40 GW wind, ~37 GW solar).
    #   Requires rebuilding branch.csv and gen.csv on adroit from updated scripts.
   12) TAG="targeted-hv";          SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 13: jun17-targeted — June 17 2024 with targeted 345 kV overrides + full renewable fleet.
    #   Expected: WESTEX binding survives + Houston LMPs drop from $850 to reasonable.
   13) TAG="jun17-targeted";       SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 14: all345-2400 — ALL 345 kV at 2400 MVA EXCEPT Morgan Creek→Tonkawa (WESTEX, 1200).
    #   Tests whether broad 345 kV upgrade eliminates all non-WESTEX congestion while preserving
    #   the zone LMP spread. Replaces whack-a-mole approach.
   14) TAG="all345-2400";           SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 15: jun17-all345 — June 17 with all 345 kV at 2400 except WESTEX.
   15) TAG="jun17-all345";          SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 16: real-ratings — 138 kV at 250 MVA (Texas-2k calibrated), 345 kV unchanged.
    #   Requires rebuilding branch.csv from updated build_osm_branch_table.py.
   16) TAG="real-ratings";            SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 17: jun17-real — June 17 with realistic 138 kV ratings.
   17) TAG="jun17-real";              SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # --- Session 2026-03-24: SPL segment fix (138 kV at 250 MVA, SPL segments
    #     receive voltage-tier ratings instead of 999,999 MVA).
    #     Requires rebuilding branch.csv from updated build_osm_branch_table.py. ---
    # Task 18: spl-fix — Nov 5 constant load, SPL segments properly rated at 250 MVA.
   18) TAG="spl-fix";                 SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 19: jun17-spl-fix — June 17 2024, hourly load/CFs, SPL segments properly rated.
   19) TAG="jun17-spl-fix";           SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 20: jan08-spl-fix — Jan 8 2024 (extreme winter wind day), hourly load/CFs,
    #     SPL segments properly rated. Third calibration day: 25+ GW sustained wind.
   20) TAG="jan08-spl-fix";           SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # Task 21: jan08-clean — Jan 8 2024 with clean-build config (600 MVA 138 kV, SPL unconstrained).
    #     Baseline comparison for the new winter calibration day.
    #     Requires restoring clean-build branch.csv (rebuild with 600 MVA and SPL at 999k).
   21) TAG="jan08-clean";             SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # --- Session 2026-03-24 (round 2): Smart SPL ratings.
    #     138 kV at 250 MVA (realistic). SPL branches near 345 kV get 1000 MVA
    #     (transformer proxy); pure 138 kV SPL branches at 250 MVA.
    #     Requires rebuilding branch.csv from updated build_osm_branch_table.py. ---
    # Task 22: xfmr-nov5 — Nov 5, constant load, smart SPL (transformer proxy) ratings.
   22) TAG="xfmr-nov5";              SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 23: xfmr-jun17 — June 17 2024, hourly, smart SPL ratings.
   23) TAG="xfmr-jun17";             SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 24: xfmr-jan08 — Jan 8 2024, hourly, smart SPL ratings.
   24) TAG="xfmr-jan08";             SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # --- Tasks 25-27: xfmr v2 — transformer proxy (1000 MVA) + T-junction aggregation
    #     (2× voltage-tier = 500 MVA for 138 kV SPL segments).
   25) TAG="xfmr2-nov5";             SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
   26) TAG="xfmr2-jun17";            SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
   27) TAG="xfmr2-jan08";            SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # --- Tasks 28-30: xfmr v3 — broader transformer proxy (ANY branch at 345→138 kV
    #     interface, not just SPL) + T-junction aggregation (SPL at 2× tier = 500 MVA).
   28) TAG="xfmr3-nov5";             SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
   29) TAG="xfmr3-jun17";            SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
   30) TAG="xfmr3-jan08";            SCALE="1";   NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV="";  SCALE_LV="";  NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # --- V2 TOPOLOGY: fixed topology extraction (audit3_24_26.md fixes 1-6),
    #     cross-voltage node merge, 4× SPL, bridge-load compensation.
    #     Uses sced_inputs_v2/ as BASE_DIR instead of sced_inputs/. ---
    # Task 31: v2-nov5 — Nov 5 constant load, v2 topology baseline.
   31) TAG="v2-nov5";   BASE="sced_inputs_v2"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 32: v2-jun17 — June 17 2024, hourly load/CFs, v2 topology.
   32) TAG="v2-jun17";  BASE="sced_inputs_v2"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 33: v2-jan08 — Jan 8 2024, hourly load/CFs, v2 topology.
   33) TAG="v2-jan08";  BASE="sced_inputs_v2"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # --- V2 with 600 MVA 138 kV base (matching clean-build).
    #     v2-nov5 showed 4,306 MW shed with 250 MVA — all 33 binding branches were 138 kV.
    #     600 MVA is validated from clean-build (81.7 MW shed). ---
    # Task 34: v2-600-nov5 — Nov 5, v2 topology + 600 MVA 138 kV base.
   34) TAG="v2-600-nov5"; BASE="sced_inputs_v2"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2025-11-05"; HL=""; HC="" ;;
    # Task 35: v2-600-jun17 — June 17 2024, hourly load/CFs, v2 topology + 600 MVA.
   35) TAG="v2-600-jun17"; BASE="sced_inputs_v2"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-06-17"; HL="$SCRATCH/hourly_load_20240617.csv"; HC="$SCRATCH/hourly_cf_20240617.csv" ;;
    # Task 36: v2-600-jan08 — Jan 8 2024, hourly load/CFs, v2 topology + 600 MVA.
   36) TAG="v2-600-jan08"; BASE="sced_inputs_v2"; SCALE="1"; NO_SPL="0"; LOAD_NAMED="0"; SCALE_HV=""; SCALE_LV=""; NO_PLANT="0"; SCED_DT="2024-01-08"; HL="$SCRATCH/hourly_load_20240108.csv"; HC="$SCRATCH/hourly_cf_20240108.csv" ;;
    # --- V2 with 600 MVA base, SPL_MULT=1 (T-junctions at line rating).
    #     v2-600 with 4× SPL created 2400 MVA corridors, bypassing WESTEX (1200 MVA).
    #     SPL_MULT=1 is physically correct: split-point branches carry same rating as parent line.
    #     Need to rebuild branch.csv with SPL_MULT=1 on adroit first. ---
    # Task 37: v2-spl1-nov5 — Nov 5, v2 topology, 600 MVA base, SPL_MULT=1.
