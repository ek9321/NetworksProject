#!/bin/bash
#SBATCH --job-name=dartboard-array
#SBATCH --output=/scratch/network/js0735/dartboard/logs/%x_%A_%a.out
#SBATCH --error=/scratch/network/js0735/dartboard/logs/%x_%A_%a.err
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --partition=all
#SBATCH --array=117
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=js0735@princeton.edu

# ---------------------------------------------------------------------------
# Dartboard branch-limit sensitivity — SLURM array
#
# Task 0: floor            — no branch limits (Cont Rating → 999,999 MVA)    [DONE]
# Task 1: 2x               — double all branch ratings                        [DONE]
# Task 2: no-spl-cap       — unconstrain SPL synthetic junction branches only [DONE]
# Task 3: no-spl+load-fix  — no-spl-cap + load only on named non-plant buses [DONE]
# Task 4: no-spl+hv2x     — no-spl-cap + double all 345 kV branch ratings   [DONE]
# Task 5: no-spl+138kv2x  — no-spl-cap + double all 138 kV branch ratings    [DONE]
# Task 6: best-so-far     — no-spl + plant outlets free + 138 kV 2x          [DONE]
# Task 7: clean-build      — rebuilt branch.csv (600 MVA 138kV, SPL+plant
#                            baked in); no runtime env var patches             [TODO]
# Task 8: jun17-hourly     — June 17 2024 calibration day, hourly load/CFs   [DONE]
# Task 9: hv2400           — clean-build + SCALE_345KV=2                     [DONE]
# Task 10: hv-default2     — 345 kV default=2 circuits                       [DONE]
# Task 11: jun17-hv2400    — June 17 + SCALE_345KV=2 (WESTEX eliminated)    [DONE]
# Task 12: targeted-hv     — targeted 345 kV overrides (Nov 5)              [TODO]
# Task 13: jun17-targeted  — June 17 + targeted overrides (WESTEX test)     [TODO]
#
# Submit single task:
#   ssh adroit "sbatch --array=7-7 /scratch/network/js0735/dartboard/run_sced_array.slurm"
#
# Results land in:
#   $SCRATCH/sced_inputs_<TAG>/results_<TAG>/
# ---------------------------------------------------------------------------

SCRATCH=/scratch/network/js0735/dartboard
ENV=/home/js0735/.conda/envs/vatic-test

